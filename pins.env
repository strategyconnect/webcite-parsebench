# Everything the re-score depends on, pinned. Sourced by scripts/rescore.sh.
# ParseBench harness: release parse-bench 2.1.2 (the scorer the 91.74 row was computed with).
PARSEBENCH_REPO=https://github.com/run-llama/ParseBench.git
PARSEBENCH_COMMIT=c21adae59f7f2ef3e8690387a0413a2e4d274486
# ParseBench-2 annotations and documents (Hugging Face dataset revision).
DATASET_REPO=llamaindex/ParseBench-2
DATASET_REVISION=f0757ac998ef9eb9c3c346ef170fee175b6a7d75
# Webcite's published per-document outputs: Hugging Face discussion 14 (refs/pr/14) on the results dataset.
RESULTS_REPO=llamaindex/ParseBench-2-results
RESULTS_REVISION=906642365c8dbf0895ac7f866a3685910d6891c4
RESULTS_PIPELINE=webcite
# Re-score tolerance used by the ParseBench leaderboard verification bot, in points.
TOLERANCE=0.5
